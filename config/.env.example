# =============================================================================
#  Alves Carneiro Advocacia e Consultoria Jurídica - Variaveis de ambiente (TEMPLATE)
#  Copie este arquivo para  config/.env  e preencha com as credenciais DO
#  ESCRITORIO. NUNCA versione o .env real. TODOS os valores comecam VAZIOS -
#  nenhuma credencial da Dra. Fabiana foi recebida ate a criacao deste
#  repositorio (ver docs/ONBOARDING.md).
#  (As automacoes rodam de forma segura/neutra enquanto algo nao estiver preenchido.)
# =============================================================================

# -----------------------------------------------------------------------------
#  IDENTIDADE DO ESCRITORIO
# -----------------------------------------------------------------------------
ESCRITORIO_NOME=Alves Carneiro Advocacia e Consultoria Jurídica
NOME_ESCRITORIO=Alves Carneiro Advocacia e Consultoria Jurídica
ESCRITORIO_RAZAO_SOCIAL=Alves Carneiro Advocacia e Consultoria Jurídica
ESCRITORIO_CNPJ=
# OAB da sociedade (usada nos cabecalhos de contrato/procuracao, se houver):
ESCRITORIO_OAB_SOCIEDADE=
ESCRITORIO_ADVOGADO=Dra. Fabiana Silva Alves Carneiro
# OAB do advogado responsavel (usada na assinatura das pecas):
ESCRITORIO_OAB=OAB/RJ 188.762
ESCRITORIO_ASSINATURA=Dra. Fabiana Silva Alves Carneiro - OAB/RJ 188.762 - Rio de Janeiro/RJ
ESCRITORIO_CIDADE=Rio de Janeiro/RJ
CIDADE_FORO=Rio de Janeiro/RJ
# Endereco fisico do escritorio - AINDA NAO RECEBIDO (preencher no onboarding):
ESCRITORIO_ENDERECO=
# Telefone/e-mail INSTITUCIONAIS:
ESCRITORIO_TELEFONE=(21) 99485-7337
ESCRITORIO_SITE=
ESCRITORIO_EMAIL=dra.fabiana@alvescarneiroadvocaciaeconsultoriajuridica.com
ESCRITORIO_EMAIL_FINANCEIRO=
ESCRITORIO_EMAIL_RESPONSAVEL=dra.fabiana@alvescarneiroadvocaciaeconsultoriajuridica.com
# Signatario padrao (advogado) no ZapSign/ADVBOX:
ADVOGADO_RESPONSAVEL_NOME=Dra. Fabiana Silva Alves Carneiro
ADVOGADO_RESPONSAVEL_EMAIL=dra.fabiana@alvescarneiroadvocaciaeconsultoriajuridica.com

# -----------------------------------------------------------------------------
#  CREDENCIAIS / TOKENS  (preencher no onboarding - NENHUMA recebida ainda)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# ADVBOX - sistema juridico do escritorio (confirmado em uso).
ADVBOX_API_TOKEN=
ASAAS_API_TOKEN=
ASAAS_BASE_URL=https://api.asaas.com/v3
ZAPSIGN_API_TOKEN=
ATENDE_DIREITO_TOKEN=
# Caminho do JSON de credenciais do Google Cloud (service account ou OAuth):
GOOGLE_APPLICATION_CREDENTIALS=config/credentials.json
GOOGLE_OAUTH_CREDENTIALS=config/oauth_credentials.json
# Caminho do executavel do Tesseract (OCR), se nao estiver no PATH:
TESSERACT_CMD=
# Modelo LLM usado na geracao de pecas (opcional; ha default no codigo):
LLM_MODEL_PECA=

# -----------------------------------------------------------------------------
#  GOOGLE DRIVE / DOCS  - IDs das pastas e modelos DO ESCRITORIO
#  (crie as pastas/modelos no Drive do escritorio e cole os IDs aqui)
# -----------------------------------------------------------------------------
# Ficha-molde (Google Doc usado como template da Ficha do Cliente):
GOOGLE_TEMPLATE_ID=
# Pasta raiz onde sao criadas as pastas de cliente:
GOOGLE_PASTA_RECLAMANTE=
# Planilha de controle de contratos (numeracao sequencial):
GOOGLE_SHEETS_CONTRATOS_ID=
GOOGLE_PLANILHA_CONTRATOS=
GOOGLE_ABA_CONTRATOS=
# Modelos (Google Docs) e pastas de destino dos documentos do intake.
# Existem dois nomes (com e sem sufixo _ID) - preencha AMBOS com o mesmo valor:
GOOGLE_TEMPLATE_CONTRATO_ID=
GOOGLE_TEMPLATE_CONTRATO=
GOOGLE_PASTA_CONTRATO_ID=
GOOGLE_PASTA_CONTRATO=
GOOGLE_TEMPLATE_PROCURACAO_ID=
GOOGLE_TEMPLATE_PROCURACAO=
GOOGLE_PASTA_PROCURACAO_ID=
GOOGLE_PASTA_PROCURACAO=
GOOGLE_TEMPLATE_DECLARACAO_ID=
GOOGLE_TEMPLATE_DECLARACAO=
GOOGLE_PASTA_DECLARACAO_ID=
GOOGLE_PASTA_DECLARACAO=

# -----------------------------------------------------------------------------
#  GOOGLE DRIVE  - Financeiro / Operacional
# -----------------------------------------------------------------------------
DRIVE_PASTA_FECHAMENTO_ID=
DRIVE_PASTA_FINANCEIRO_ID=
DRIVE_PLANILHA_HISTORICO_ID=
DRIVE_PLANILHA_RESULTADO_ID=
# Pasta de clientes usada pelo handler de sincronizacao de assinados:
DRIVE_PASTA_CLIENTES_ID=

# -----------------------------------------------------------------------------
#  USUARIOS ADVBOX  (IDs do painel ADVBOX > Usuarios - ver config/equipe.py)
# -----------------------------------------------------------------------------
# IDs reais em: painel ADVBOX > Usuarios, ou
#   python INTEGRACOES/advbox_integration.py  (lista tudo)
ADVBOX_USER_RESPONSAVEL=
ADVBOX_USER_OPERACIONAL=
ADVBOX_USER_FINANCEIRO=
# Campo 'from' das tarefas /posts (quem assina a tarefa):
ADVBOX_USER_FROM=
# Mapa opcional p/ exibir nomes nos relatorios: "ID:NOME,ID:NOME"
ADVBOX_USERS_MAP=

# Defaults de cadastro de processo (nomes, nao IDs - a busca ignora acento).
# Vazio em TIPO = cadastrar_processo() exige dados_processo['tipo'] e falha com
# mensagem clara em vez de chutar o primeiro tipo da lista.
ADVBOX_TIPO_PROCESSO_PADRAO=
ADVBOX_STAGE_PADRAO=
ADVBOX_ORIGEM_PADRAO=

# -----------------------------------------------------------------------------
#  AGENTE OPERACIONAL (CARNEIRO.IA)  - servidor webhook
# -----------------------------------------------------------------------------
AGENTE_OP_TOKEN=
AGENTE_OP_PORT=8787
# ID do usuario-agente no ADVBOX (conta a quem as tarefas do agente sao atribuidas):
ADVBOX_USER_AGENTE=
# Tipo de tarefa (settings['tasks']) usado nos retornos do agente:
ADVBOX_TASK_TYPE_ACOMPANHAMENTO=
# Notificacao WhatsApp ao concluir tarefa (1 = liga, 0 = desliga):
AGENTE_OP_NOTIFICAR_WHATSAPP=1
# Telefones internos p/ notificacao - JSON {"<advbox_user_id>": "<telefone>"}:
AGENTE_OP_USER_PHONES=

# -----------------------------------------------------------------------------
#  RELATORIO DIARIO DE PRAZOS (OPERACIONAL/prazos_diario.py, 9h)
# -----------------------------------------------------------------------------
# Envio por e-mail da lista de prazos em aberto. Sem estas variaveis o
# relatorio ainda e gerado e salvo em OPERACIONAL/relatorios_prazos/ - so nao
# e enviado, e o script avisa.
# Servidor de saida do e-mail do escritorio (perguntar ao provedor de hospedagem
# ou, no Google Workspace: smtp.gmail.com / 587 / starttls, com SENHA DE APP -
# a senha normal da conta nao funciona com 2FA ativa).
SMTP_HOST=
SMTP_PORT=587
# starttls (porta 587, o mais comum) | ssl (porta 465) | nenhuma
SMTP_SEGURANCA=starttls
SMTP_USER=
SMTP_PASSWORD=
# Remetente; vazio = usa o SMTP_USER:
SMTP_REMETENTE=
# Destinatario(s) do relatorio, separados por virgula.
# Vazio = usa ESCRITORIO_EMAIL_RESPONSAVEL.
PRAZOS_EMAIL_PARA=

# Canal de envio do relatorio diario: email | whatsapp | ambos
PRAZOS_ENVIO=ambos
# WhatsApp da Dra. Fabiana (via Atende Direito - exige ATENDE_DIREITO_TOKEN).
# O Atende Direito envia para CONTATO ja cadastrado nele; se este numero nao
# estiver na base de contatos, o envio nao sai.
PRAZOS_WHATSAPP_PARA=

# -----------------------------------------------------------------------------
#  MONITOR DIARIO DE ACORDAOS DO TCU (OPERACIONAL/monitor_tcu.py, 17:30)
# -----------------------------------------------------------------------------
# Usa o mesmo SMTP_* acima e a ANTHROPIC_API_KEY (resumo de cada acordao).
# Sem a chave o relatorio sai so por palavra-chave. Temas em config/termos_tcu.py.
# Destinatario(s); vazio = usa PRAZOS_EMAIL_PARA.
TCU_EMAIL_PARA=
# Modelo do Claude usado no resumo:
TCU_MODELO=claude-sonnet-5-5

# Infinitum - API publica (https://docs.infinitum.app.br/guide)
# Token: Infinitum > configuracoes > API publica. Cabecalho X-Public-Token.
INFINITUM_API_TOKEN=
INFINITUM_ORG_ID=067c892a-a938-450c-9966-22fd296b1263

# Jurisprudencias.ai - busca de jurisprudencia (https://jurisprudencias.ai/openapi.json)
# Token (prefixo jur_): https://jurisprudencias.ai/api-tokens. Cota: 5 consultas/dia.
JURISPRUDENCIAS_API_TOKEN=

# -----------------------------------------------------------------------------
# META (Facebook/Instagram) - Marketing API (INTEGRACOES/meta_integration.py)
# Token de usuario de sistema do Gerenciador de Negocios (nao expira)
# -----------------------------------------------------------------------------
META_ACCESS_TOKEN=
META_API_VERSION=v21.0
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_INSTAGRAM_ID=
